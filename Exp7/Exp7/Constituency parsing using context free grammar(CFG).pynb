{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOo+mXDZqNf7pKV+37ksfe5"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"g7Y12fefGGZB","executionInfo":{"status":"ok","timestamp":1780382075730,"user_tz":-330,"elapsed":4032,"user":{"displayName":"Bidyaluxmi Heisnam","userId":"14768671525881400193"}},"outputId":"d16cf0f8-3b4b-4435-9108-1dbc6ca9e3ba"},"outputs":[{"output_type":"stream","name":"stderr","text":["[nltk_data] Downloading package punkt to /root/nltk_data...\n","[nltk_data]   Unzipping tokenizers/punkt.zip.\n"]},{"output_type":"stream","name":"stdout","text":["Sentence:\n","['the', 'boy', 'likes', 'the', 'book']\n","\n","Parse Trees:\n","(S (NP (Det the) (N boy)) (VP (V likes) (NP (Det the) (N book))))\n","              S               \n","      ________|____            \n","     |             VP         \n","     |         ____|___        \n","     NP       |        NP     \n","  ___|___     |     ___|___    \n","Det      N    V   Det      N  \n"," |       |    |    |       |   \n","the     boy likes the     book\n","\n"]}],"source":["import nltk\n","nltk.download('punkt')\n","from nltk import CFG\n","from nltk.parse import ChartParser\n","import matplotlib.pyplot as plt\n","\n","# ==================================================\n","# Define Context-Free Grammar (CFG)\n","# ==================================================\n","\n","grammar = CFG.fromstring(\"\"\"\n","\n","S -> NP VP\n","\n","NP -> Det N\n","NP -> Det Adj N\n","NP -> Pronoun\n","\n","VP -> V\n","VP -> V NP\n","VP -> V PP\n","\n","PP -> P NP\n","\n","Det -> 'the' | 'a'\n","Adj -> 'red' | 'big'\n","N -> 'boy' | 'girl' | 'book' | 'dog'\n","Pronoun -> 'he' | 'she'\n","\n","V -> 'reads' | 'likes' | 'runs'\n","P -> 'with' | 'to'\n","\n","\"\"\")\n","\n","# ==================================================\n","# Create parser\n","# ==================================================\n","\n","parser = ChartParser(grammar)\n","\n","# ==================================================\n","# Input sentence\n","# ==================================================\n","\n","sentence = \"the boy likes the book\"\n","\n","tokens = sentence.lower().split()\n","\n","print(\"Sentence:\")\n","print(tokens)\n","\n","# ==================================================\n","# Parse sentence\n","# ==================================================\n","\n","trees = list(parser.parse(tokens))\n","\n","if len(trees) == 0:\n","    print(\"No valid parse found\")\n","\n","else:\n","    print(\"\\nParse Trees:\")\n","\n","    for tree in trees:\n","        print(tree)\n","\n","        # Show tree graphically\n","        tree.pretty_print()\n","\n","        # Optional graphical window\n","        # tree.draw()\n"]},{"cell_type":"code","source":[],"metadata":{"id":"Ma0C1rGtGODY"},"execution_count":null,"outputs":[]}]}